# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# With nothing set, the studio runs locally on SQLite with an in-process job pool.

# --- Studio scale profile (see docker-compose.yml) ---
# DATABASE_URL=postgresql+psycopg://studio:studio_dev@127.0.0.1:5433/studio
# REDIS_URL=redis://127.0.0.1:6379/0          # set => jobs run on Celery workers
# S3_ENDPOINT=http://127.0.0.1:9100           # set => MinIO / S3 artifact store
# S3_ACCESS_KEY=studio
# S3_SECRET_KEY=studio_dev_secret
# S3_BUCKET=studio-artifacts
# STUDIO_SECRET_KEY=<long random string>      # JWT signing; auto-generated into data/ when unset
# STUDIO_DATA_DIR=./data/studio
# STUDIO_MAX_UPLOAD_MB=200
# STUDIO_JOB_WORKERS=2
# STUDIO_CORS_ORIGINS=http://localhost:3000

# --- Azure OpenAI / AI Foundry: embeddings, chat (answers, reranking, query transforms) and vision ---
RAG_EMBEDDING_BACKEND=azure                   # prototype only: "azure" or "fake"
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Deployment NAMES on your resource (not secrets). Chat answers, reranking and query transforms use the first;
# the vision deployment (for describing diagram pages) must accept images, e.g. gpt-4o.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_CHAT_DEPLOYMENTS=gpt-4o-mini,gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o

# --- Optional providers (each shows "not configured" in Settings until set) ---
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5      # local semantic embeddings, no key; downloads once
# FASTEMBED_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # local cross-encoder reranker
# PGVECTOR_URL=postgresql://studio:studio_dev@127.0.0.1:5435/rag_vectors   # needs the pgvector extension (compose uses the pgvector image)
# OPENAI_API_KEY=         # openai embeddings and openai:<model> chat
# ANTHROPIC_API_KEY=      # anthropic:<model> chat
# GEMINI_API_KEY=         # gemini:<model> chat
# COHERE_API_KEY=         # cohere embeddings
# VOYAGE_API_KEY=         # voyage embeddings
# OLLAMA_URL=http://localhost:11434   # ollama embeddings and ollama:<model> chat
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=   AZURE_DOCUMENT_INTELLIGENCE_KEY=   # optional upload parser

# Optional shared download cache for local embedding, reranking and CLIP models.
# STUDIO_MODEL_CACHE_DIR=D:/RAG-I/data/studio/models

# --- Auto generation (all existing providers above remain supported) ---
# Set the key(s) you have. This selects by presence, not by a live validation call.
# Priority: Google -> NVIDIA -> OpenAI -> configured Azure -> other configured providers.
STUDIO_CHAT_MODEL=auto
STUDIO_EMBEDDING_PROVIDER=fastembed
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemma-4-26b-a4b-it
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: STUDIO_DISABLE_AZURE=true (keeps Azure credentials stored, prevents Azure calls)
# Optional vision override: STUDIO_VISION_MODEL=gemini:gemma-4-26b-a4b-it
# Empty STUDIO_CHAT_MODEL preserves the previous Azure-first behavior.
